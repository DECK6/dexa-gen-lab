{
  "name": "dexa-gen-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run lint:registry && bun run audit:catalog && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint:registry": "node scripts/lint-registry.mjs",
    "audit:catalog": "node scripts/audit-catalog.mjs",
    "test:audit": "bun test scripts/audit-catalog.test.mjs",
    "thumbs": "node scripts/thumbs.mjs",
    "test:e2e": "playwright test",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "p5": "^2.3.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/p5": "^1.7.7",
    "@types/three": "^0.185.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
